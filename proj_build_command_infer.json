  "linux_v7_0-rc1": {
    "prepare_for_build": [
      {
        "command": "make CC=clang-17 clean",
        "can_error": true
      },
      {
        "command": "make CC=clang-17 mrproper",
        "can_error": false
      },
      {
        "command": "make CC=clang-17 allmodconfig",
        "can_error": false
      },
      {
        "command": "sed -i 's#^CONFIG_SYSTEM_TRUSTED_KEYS=.*#CONFIG_SYSTEM_TRUSTED_KEYS=\"\"#' .config",
        "can_error": false
      },
      {
        "command": "sed -i 's#^CONFIG_SYSTEM_REVOCATION_KEYS=.*#CONFIG_SYSTEM_REVOCATION_KEYS=\"\"#' .config",
        "can_error": false
      },
      {
        "command": "make CC=clang-17 olddefconfig",
        "can_error": false
      },
      {
        "command": "make CC=clang-17 modules_prepare",
        "can_error": false
      },
      {
        "command": "make CC=clang-17 drivers/staging/ clean",
        "can_error": true
      },
      {
        "command": "make CC=clang-17 drivers/staging/ -k -j$(nproc)",
        "can_error": true
      },
      {
        "command": "python3 scripts/clang-tools/gen_compile_commands.py drivers/staging/ -o compile_commands.json",
        "can_error": false
      }
    ],
    "build_command": {
      "command": "make CC=clang-17 drivers/staging/ -k",
      "can_error": true
    }
  }
